{
  "rules": {
    "users": {
      ".read": true,
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$userId": {
        "name": {
          ".write": "auth != null && root.child('members').child(auth.uid).val() === $userId && newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        }
      }
    },

    "members": {
      ".indexOn": ".value",
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.isString() && (!data.exists() || data.val() === newData.val()) && root.child('users').child(newData.val()).exists() && (auth.token.email === newData.val().toLowerCase().replace(' ', '-').replace('\\'', '-').replace('--', '-').replace('--', '-') + '@plt.internal' || (auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && root.child('googleLogins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === newData.val()))"
      }
    },

    "googleLogins": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$key": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && $key === auth.token.email.toLowerCase().replace('.', ',')"
      }
    },

    "pins": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$userId": {
        ".write": "auth != null && root.child('members').child(auth.uid).val() === $userId && newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
      }
    },

    "leads": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()",
      "$leadId": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists() && (!data.exists() || (!newData.exists() && (root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management' || root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'admin')))",
        "audit": {
          "$auditId": {
            ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists() && (!data.exists() || (!newData.exists() && (data.child('type').val() === 'note' || data.child('isNote').val() === true || (data.child('text').isString() && data.child('text').val().matches(/^(Call|Text|Email|Appointment|Other contact|Contact) note: /))) && (root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management' || data.parent().parent().child('advisorId').val() === root.child('members').child(auth.uid).val())))"
          }
        },
        "$field": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()"
        }
      }
    },

    "notifications": {
      ".indexOn": ["toUserId", "toRole", "at"],
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()"
    },

    "sib": {
      "cases": {
        ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()",
        ".indexOn": ["month"],
        "$caseId": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists() && (!data.exists() || (!newData.exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'))",
          "audit": {
            "$auditId": {
              ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists() && !data.exists()"
            }
          },
          "$field": {
            ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()"
          }
        }
      }
    },

    "commercial": {
      "cases": {
        ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('commercial').val() === true",
        "$caseId": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('commercial').val() === true && (!data.exists() || (!newData.exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'))",
          "audit": {
            "$auditId": {
              ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('commercial').val() === true && !data.exists()"
            }
          },
          "$field": {
            ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('commercial').val() === true"
          }
        }
      }
    },

    "logins": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$userId": {
        ".write": "auth != null && root.child('members').child(auth.uid).val() === $userId",
        ".validate": "newData.hasChildren(['lastSeen'])",
        "lastLogin": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "config": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'"
    },

    "clientSources": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).exists() && (root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management' || root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'admin')"
    },

    "signatures": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management'",
      "$userId": {
        ".read": "auth != null && (root.child('members').child(auth.uid).val() === $userId || root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management')",
        ".write": "auth != null && (root.child('members').child(auth.uid).val() === $userId || root.child('members').child(auth.uid).exists() && root.child('users').child(root.child('members').child(auth.uid).val()).child('role').val() === 'management')",
        ".validate": "newData.isString() && newData.val().length <= 100000"
      }
    }
  }
}
